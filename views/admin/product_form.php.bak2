<script>
    // Basic JS for form interactions if needed, e.g., disabling submit on click
    document.querySelector('form').addEventListener('submit', function() {
        const submitBtn = this.querySelector('button[type="submit"]');
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Saving...';
        }
    });

     // Simple handling for textarea lists to JSON-compatible arrays (on client side, server needs robust parsing)
     // This is a basic example; a more robust solution might involve dynamic input fields
     const benefitsTextarea = document.getElementById('benefits');
     const galleryTextarea = document.getElementById('gallery_images');
     const form = document.querySelector('form');

     if (form && benefitsTextarea) {
         const hiddenBenefitsInput = document.createElement('input');
         hiddenBenefitsInput.type = 'hidden';
         hiddenBenefitsInput.name = 'benefits_json'; // Server will look for this if needed
         form.appendChild(hiddenBenefitsInput);

         benefitsTextarea.addEventListener('input', () => {
             const lines = benefitsTextarea.value.split('\n').map(line => line.trim()).filter(line => line.length > 0);
             hiddenBenefitsInput.value = JSON.stringify(lines);
         });
         // Trigger initial processing
          const initialBenefitLines = benefitsTextarea.value.split('\n').map(line => line.trim()).filter(line => line.length > 0);
          hiddenBenefitsInput.value = JSON.stringify(initialBenefitLines);
     }
     // Similar logic for gallery_images
      if (form && galleryTextarea) {
          const hiddenGalleryInput = document.createElement('input');
          hiddenGalleryInput.type = 'hidden';
          hiddenGalleryInput.name = 'gallery_images_json'; // Server will look for this
          form.appendChild(hiddenGalleryInput);

          galleryTextarea.addEventListener('input', () => {
              const lines = galleryTextarea.value.split('\n').map(line => line.trim()).filter(line => line.length > 0);
              hiddenGalleryInput.value = JSON.stringify(lines);
          });
           const initialGalleryLines = galleryTextarea.value.split('\n').map(line => line.trim()).filter(line => line.length > 0);
           hiddenGalleryInput.value = JSON.stringify(initialGalleryLines);
      }


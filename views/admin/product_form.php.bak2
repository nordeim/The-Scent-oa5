// views/admin/product_form.php
// Form for creating or editing products.

// Use the admin layout header
require_once __DIR__ . '/../layout/admin_header.php';

// Determine if we are editing or creating
$isEditing = isset($product) && !empty($product['id']);
$formAction = $isEditing
    ? 'index.php?page=admin&section=products&task=save&id=' . urlencode($product['id'])
    : 'index.php?page=admin&section=products&task=save';

// Helper function to get value for form fields
function getFieldValue($product, $field, $default = '') {
    return isset($product[$field]) ? htmlspecialchars($product[$field]) : $default;
}
function getCheckedValue($product, $field, $value = 1) {
    return isset($product[$field]) && $product[$field] == $value ? 'checked' : '';
}
?>

